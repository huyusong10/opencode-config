  "mcp": {
    "WebSearch": {
      "type": "remote",
      "url": "https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp",
      "headers": {
        "Authorization": "{env:OPENCODE_MCP_WEBSEARCH_KEY}"
      },
      "enabled": false
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:OPENCODE_CONTEXT7_KEY}"
      },
      "enabled": false
    }
  },
  "model": "alibaba-coding-plan/glm-5",
  "small_model": "alibaba-coding-plan/qwen3.5-plus",
  "permission": {
    "external_directory": {
      "*": "ask",
      "~/.config/opencode/*": "allow",
      "~/.zshrc": "allow",
      "/tmp/*": "allow"
    }
  },
  "plugin": [
    "@mohak34/opencode-notifier@latest",
    "opencode-pty@latest",
    "./plugin/guard.ts",
    "./plugin/task-logger.ts",
    "opencode-worktree@latest"
  ],
  "instructions": [
    "rules/ascii-diagrams.md",
    "rules/codeact.md",
    "rules/subagent.md"
  ]
}