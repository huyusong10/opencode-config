{
  "$schema": "https://opencode.ai/config.json",

  // ============================================================================
  // 模型提供商配置
  // ============================================================================

  "provider": {
    // 阿里云 Coding Plan - 阿里云编程助手 API
    // 文档: https://help.aliyun.com/zh/coding-assistant/
    "alibaba-coding-plan": {
      "npm": "@ai-sdk/anthropic",
      "name": "Aliyun Coding Plan",
      "options": {
        "baseURL": "https://coding.dashscope.aliyuncs.com/apps/anthropic/v1",
        "apiKey": "{env:OPENCODE_ALIBABA_API_KEY}"
      },
      "models": {
        // Qwen3.5 Plus - 通用模型，支持图文输入，适合轻量任务
        "qwen3.5-plus": {
          "name": "Qwen3.5 Plus",
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "options": { "thinking": { "type": "enabled", "budgetTokens": 8192 } },
          "limit": { "context": 1000000, "output": 65536 }
        },
        // Qwen3 Max - 最新旗舰模型，推理能力强
        "qwen3-max-2026-01-23": {
          "name": "Qwen3 Max 2026-01-23",
          "modalities": { "input": ["text"], "output": ["text"] },
          "limit": { "context": 262144, "output": 32768 }
        },
        // Qwen3 Coder Next - 代码专项模型，编程能力突出
        "qwen3-coder-next": {
          "name": "Qwen3 Coder Next",
          "modalities": { "input": ["text"], "output": ["text"] },
          "limit": { "context": 262144, "output": 65536 }
        },
        // Qwen3 Coder Plus - 代码模型，超长上下文
        "qwen3-coder-plus": {
          "name": "Qwen3 Coder Plus",
          "modalities": { "input": ["text"], "output": ["text"] },
          "limit": { "context": 1000000, "output": 65536 }
        },
        // MiniMax M2.5 - MiniMax 模型，支持思维链
        "MiniMax-M2.5": {
          "name": "MiniMax M2.5",
          "modalities": { "input": ["text"], "output": ["text"] },
          "options": { "thinking": { "type": "enabled", "budgetTokens": 8192 } },
          "limit": { "context": 196608, "output": 24576 }
        },
        // GLM-5 - 智谱最新模型，思维链能力强，当前主用模型
        "glm-5": {
          "name": "GLM-5",
          "modalities": { "input": ["text"], "output": ["text"] },
          "options": { "thinking": { "type": "enabled", "budgetTokens": 8192 } },
          "limit": { "context": 202752, "output": 16384 }
        },
        // GLM-4.7 - 智谱上一代模型
        "glm-4.7": {
          "name": "GLM-4.7",
          "modalities": { "input": ["text"], "output": ["text"] },
          "options": { "thinking": { "type": "enabled", "budgetTokens": 8192 } },
          "limit": { "context": 202752, "output": 16384 }
        },
        // Kimi K2.5 - 月之暗面模型，支持图文输入
        "kimi-k2.5": {
          "name": "Kimi K2.5",
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "options": { "thinking": { "type": "enabled", "budgetTokens": 8192 } },
          "limit": { "context": 262144, "output": 32768 }
        }
      }
    },

    // 腾讯 Coding Plan - 腾讯云编程助手 API
    "tencent-coding-plan": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Tencent Coding Plan",
      "options": {
        "baseURL": "https://api.lkeap.cloud.tencent.com/coding/v3",
        "apiKey": "{env:OPENCODE_TENCENT_API_KEY}"
      },
      "models": {
        // Auto - 自动选择最优模型
        "tc-code-latest": {
          "name": "Auto",
          "modalities": { "input": ["text"], "output": ["text"] },
          "options": { "thinking": { "type": "enabled", "budgetTokens": 8192 } },
          "limit": { "context": 196608, "output": 32768 }
        },
        // Hunyuan 2.0 Instruct - 腾讯混元指令模型
        "hunyuan-2.0-instruct": {
          "name": "Tencent HY 2.0 Instruct",
          "modalities": { "input": ["text"], "output": ["text"] },
          "options": { "thinking": { "type": "enabled", "budgetTokens": 8192 } },
          "limit": { "context": 128000, "output": 16000 }
        },
        // Hunyuan 2.0 Thinking - 腾讯混元思维模型
        "hunyuan-2.0-thinking": {
          "name": "Tencent HY 2.0 Think",
          "modalities": { "input": ["text"], "output": ["text"] },
          "options": { "thinking": { "type": "enabled", "budgetTokens": 8192 } },
          "limit": { "context": 128000, "output": 32000 }
        },
        // Hunyuan-T1 - 腾讯混元 T1 模型
        "hunyuan-t1": {
          "name": "Hunyuan-T1",
          "modalities": { "input": ["text"], "output": ["text"] },
          "options": { "thinking": { "type": "enabled", "budgetTokens": 8192 } },
          "limit": { "context": 64000, "output": 32000 }
        },
        // Hunyuan Turbos - 腾讯混元快速模型
        "hunyuan-turbos": {
          "name": "hunyuan-turbos",
          "modalities": { "input": ["text"], "output": ["text"] },
          "options": { "thinking": { "type": "enabled", "budgetTokens": 8192 } },
          "limit": { "context": 32000, "output": 16000 }
        },
        // MiniMax M2.5 - MiniMax 模型
        "minimax-m2.5": {
          "name": "MiniMax-M2.5",
          "modalities": { "input": ["text"], "output": ["text"] },
          "options": { "thinking": { "type": "enabled", "budgetTokens": 8192 } },
          "limit": { "context": 196608, "output": 32768 }
        },
        // Kimi K2.5 - 月之暗面模型
        "kimi-k2.5": {
          "name": "Kimi-K2.5",
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "options": { "thinking": { "type": "enabled", "budgetTokens": 8192 } },
          "limit": { "context": 262144, "output": 32768 }
        },
        // GLM-5 - 智谱最新模型
        "glm-5": {
          "name": "GLM-5",
          "modalities": { "input": ["text"], "output": ["text"] },
          "options": { "thinking": { "type": "enabled", "budgetTokens": 8192 } },
          "limit": { "context": 202752, "output": 16384 }
        }
      }
    }
  },

  // ============================================================================
  // MCP (Model Context Protocol) 服务器配置
  // ============================================================================

  "mcp": {
    // WebSearch - 阿里云网络搜索服务，提供联网搜索能力
    // 需要配置 OPENCODE_MCP_WEBSEARCH_KEY 环境变量
    "WebSearch": {
      "type": "remote",
      "url": "https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp",
      "headers": { "Authorization": "{env:OPENCODE_MCP_WEBSEARCH_KEY}" },
      "enabled": false
    },
    // Playwright - 浏览器自动化，用于网页抓取和交互测试
    // 通过 npx 运行，首次使用需安装浏览器依赖
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false
    },
    // Context7 - 上下文增强服务，提供文档和代码库索引
    // 需要配置 OPENCODE_CONTEXT7_KEY 环境变量
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": { "CONTEXT7_API_KEY": "{env:OPENCODE_CONTEXT7_KEY}" },
      "enabled": false
    }
  },

  // ============================================================================
  // 模型选择
  // ============================================================================

  // 主模型 - 用于复杂推理和代码生成
  "model": "alibaba-coding-plan/glm-5",
  // 小模型 - 用于标题生成等轻量任务，节省 Token
  "small_model": "alibaba-coding-plan/qwen3.5-plus",

  // ============================================================================
  // 权限配置
  // ============================================================================

  "permission": {
    "external_directory": {
      "*": "ask",                      // 默认：访问项目外目录需确认
      "~/.config/opencode/*": "allow", // OpenCode 配置目录：允许访问
      "~/.zshrc": "allow",             // Shell 配置：允许访问
      "/tmp/*": "allow"                // 临时目录：允许访问
    }
  },

  // ============================================================================
  // 插件配置
  // ============================================================================

  "plugin": [
    // -------------------------------------------------------------------------
    // 外部插件 (npm)
    // -------------------------------------------------------------------------

    // 系统通知插件 - 任务完成或出错时发送系统通知
    // 适用于 macOS/Linux/Windows，支持自定义通知样式
    "@mohak34/opencode-notifier@latest",

    // PTY 终端插件 - 提供真正的伪终端支持
    // 使交互式命令 (git commit、vim、top 等) 能正常工作
    // 支持长时间运行的进程 (dev server、watch 模式)
    "opencode-pty@latest",

    // Git Worktree 插件 - 多分支并行开发支持
    // 自动管理 git worktree，支持在不同分支独立工作
    // 适用于需要同时处理多个 PR 或功能的场景
    "opencode-worktree@latest",

    // -------------------------------------------------------------------------
    // 本地插件 (自定义)
    // -------------------------------------------------------------------------

    // Task Logger 任务日志插件 - 自动记录开发活动
    //
    // 记录内容:
    // - 会话开始/结束
    // - 任务状态变更
    // - 测试执行结果
    // - Git 提交记录
    //
    // 日志位置: .planning/.logs/
    // - daily/*.jsonl  - 按日期汇总
    // - sessions/*/    - 按会话分类
    // - tasks/         - 按任务分类
    "./plugin/task-logger.ts",

    // Deep Explore Guide 深度探索引导插件 - 失败时注入调查提示
    //
    // 设计理念: 引导而非强制，让 AI 自己决定行动
    //
    // 触发场景:
    // - 工具执行失败时注入提示，鼓励深入调查
    // - 多次失败时增强提示，避免重复相同错误
    //
    // 配置文件: plugin/deep-explore-prompts.yaml
    "./plugin/deep-explore-guide.ts",

    // System Loop 系统工程师迭代插件 - 流程末端的系统思考
    //
    // 设计理念: 自动触发系统级深度思考，发现潜在问题，提出改进建议
    //
    // 触发场景:
    // - Maestro/Architect/Maker 完成主要工作后
    // - 检测到 <system-review-request> 标签时自动触发 @system-engineer
    //
    // 迭代控制:
    // - 最大迭代次数: 可配置，默认 3 次
    // - 退出条件: decision="done" 或达到最大迭代
    //
    // 配置文件: plugin/system-loop-config.yaml
    "./plugin/system-loop.ts",

    // Ralph Loop 插件 - 持续迭代直到任务真正完成
    //
    // 核心机制: 拦截 session.idle 事件，检测 <promise> 标签
    // - 未满足完成条件 → 重新注入 prompt，强制继续循环
    // - 满足完成条件 → 停止循环
    // - 超过最大迭代次数 → 停止循环（安全阀）
    //
    // 状态文件: .claude/ralph-loop.local.md
    "./plugin/ralph.ts"
  ],

  // ============================================================================
  // 指令文件 - 注入到 AI 上下文的规则
  // ============================================================================

  "instructions": [
    // ASCII 框图规范 - 框图内必须使用英文，避免中文字符导致对齐问题
    "rules/ascii-diagrams.md",
    // Codeact 模式 - 复杂流程优先编写脚本而非直接调用工具
    "rules/codeact.md",
    // Subagent 决策指南 - 何时使用子代理、何时直接处理
    "rules/subagent.md",
    // 偏差处理规则 - 自动修复 vs 用户升级的判断规则
    "rules/deviation-rules.md",
    // Checkpoint 系统 - 任务需要用户介入时的处理协议
    "rules/checkpoint-system.md",
    // STATE.md 验证 - 状态文件一致性检查和恢复
    "rules/state-validation.md",
    // 规划模式 - 需求探索、Goal-Backward、Wave 分组
    "rules/planning-mode.md",
    // 执行模式 - 模式调度、快速通道、归档流程
    "rules/execution-mode.md"
  ]
}